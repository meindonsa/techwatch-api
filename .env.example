DATABASE_URL=postgresql://user:password@your-neon-hostname/dbname?sslmode=require
API_SECRET_TOKEN=your-secret-token-here
CRON_INTERVAL_MS=900000#15 minutes

# --------- Volume de données (rétention) ---------
# Âge maximal des articles conservés, en jours (0 = pas de purge par l'âge)
ARTICLE_RETENTION_DAYS=60
# Nombre maximal d'articles conservés par flux (0 = pas de plafond ; jamais inférieur à 100, le nombre lu par scraping)
ARTICLES_MAX_PER_FEED=200
# Taille des lots de suppression de la purge
PURGE_BATCH_SIZE=1000
# Délai minimal entre deux purges (millisecondes) — 21600000 = 6 heures
PURGE_INTERVAL_MS=21600000
# --------- JWT ---------
JWT_SECRET=your_super_secret_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_RESET_EXPIRATION=1h

# --------- Frontend ---------
FRONTEND_URL=http://localhost:5173

# --------- Mail Service (notisend) ---------
MAIL_SERVICE_URL=http://localhost:3000
MAIL_API_KEY=your-mail-api-key
# Identifiant de l'application auprès de notisend (doit exister dans MAIL_FROM de notisend)
MAIL_APP=techwatch

